# ==========================================
# 🔌 COMUNICAÇÃO COM A API (Backend)
# ==========================================
# URL base onde o servidor (API) está rodando.
# No desenvolvimento local, costuma ser http://localhost:3000
# Em produção, aponte para o seu domínio (ex: https://api.sgapp.com.br)
# NOTA: O prefixo VITE_ é obrigatório para que o frontend tenha acesso à variável.
VITE_API_URL=https://api.sgapp.com.br

# ==========================================
# 🏢 IDENTIFICAÇÃO DA LOJA (Relatórios / PDF)
# ==========================================
# Nome da empresa/loja exibido no cabeçalho dos relatórios exportados em PDF
VITE_NOME_EMPRESA="Rodrigo Veículos"
