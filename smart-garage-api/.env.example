# ==========================================
# ⚙️ AMBIENTE E SERVIDOR
# ==========================================
# Define o ambiente da aplicação (development ou production)
# Em produção, deixe como production para maior performance e segurança.
NODE_ENV=production
# Porta em que o servidor irá rodar (opcional, padrão: 3000)
PORT=3000

# ==========================================
# 🗄️ BANCO DE DADOS
# ==========================================
DB_USER=root
# NUNCA comite a senha real aqui. Deixe vazio ou use um placeholder.
DB_PASS=sua_senha_aqui
DB_NAME=smart_garage
# Em ambientes Docker, DB_HOST costuma ser o nome do serviço (ex: db)
DB_HOST=localhost
DB_PORT=3306

# ==========================================
# 🔐 SEGURANÇA (Autenticação)
# ==========================================
# Chave mestra criptográfica para gerar os tokens de login (JWT).
# Deve ser uma string forte, longa e aleatória (nunca comite a real).
JWT_SECRET=sua_chave_mestra_secreta_MUITO_LONGA

# ==========================================
# ✉️ SERVIDOR DE E-MAIL (SMTP)
# ==========================================
# Configurações para envio de e-mails (como "Esqueci a Senha")
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=sgappsuporte@gmail.com
# Senha de aplicativo do Gmail (NUNCA comite a real)
EMAIL_PASS=sua_senha_de_aplicativo_aqui

# ==========================================
# 🌐 CORS E REDES
# ==========================================
# URL exata onde o seu Frontend está rodando (sem a barra / no final).
# Usado para liberar o acesso de segurança (CORS).
FRONTEND_URL=https://expressao.sgapp.com.br

# ==========================================
# ☁️ BACKUP E GOOGLE DRIVE
# ==========================================
# ID da pasta do Google Drive onde os backups serão guardados
# (Encontrado na URL da pasta aberta no navegador: drive.google.com/drive/folders/ID_AQUI)
GOOGLE_DRIVE_FOLDER_ID=

# Credenciais da Conta de Serviço do Google Cloud (Service Account)
# Crie uma Conta de Serviço no Google Cloud Console, gere uma chave JSON e compartilhe a pasta do Drive com o email da conta.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a private_key do JSON (ou use \n para quebras de linha)
GOOGLE_SERVICE_ACCOUNT_KEY=
# Alternativamente, aponte para o arquivo JSON de credenciais:
# GOOGLE_APPLICATION_CREDENTIALS=/app/google-credentials.json

# Intervalo em horas para backup automático diário no servidor (ex: 24).
# Deixe vazio ou 0 se desejar apenas backups manuais via painel.
BACKUP_AUTO_HOURS=24
